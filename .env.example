# ============================================================
# XSpan AI Agent — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── XSpan Cloud ──────────────────────────────────────────────
# Get your API key at https://xspan.ai/api
XSPAN_API_KEY=xspan_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XSPAN_USER_ID=usr_xxxxxxxxxxxxxxxx
XSPAN_API_URL=https://api.xspan.ai/v1

# ── Apple Health (macOS only) ─────────────────────────────────
APPLE_HEALTH_ENABLED=true

# ── Google Health ─────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com
GOOGLE_HEALTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth2 callback port (default: 9876)
GOOGLE_OAUTH_PORT=9876

# ── EHR Connection ────────────────────────────────────────────
EHR_ENABLED=false
# Provider: epic | cerner | redox | generic_fhir
EHR_PROVIDER=epic
EHR_FHIR_BASE_URL=https://fhir.example.org/api/FHIR/R4
EHR_CLIENT_ID=
# OAuth2 callback port (default: 9877)
EHR_OAUTH_PORT=9877

# ── Nudge Schedule ────────────────────────────────────────────
# Cron expressions for 3 daily nudges (local time)
NUDGE_MORNING_SCHEDULE="0 8 * * *"
NUDGE_MIDDAY_SCHEDULE="0 12 * * *"
NUDGE_EVENING_SCHEDULE="0 18 * * *"

# ── Health Passport ───────────────────────────────────────────
# Weekly passport generation (default: Sunday 7am)
PASSPORT_SCHEDULE="0 7 * * 0"

# ── Data Sync ─────────────────────────────────────────────────
# How often to sync health data (minutes)
SYNC_INTERVAL_MINUTES=15
# How often to push to XSpan cloud (minutes)
CLOUD_SYNC_INTERVAL_MINUTES=60

# ── Local Storage ─────────────────────────────────────────────
# Directories for local data (defaults shown)
# DATA_DIR=~/.xspan/data
# PASSPORT_DIR=~/.xspan/passports

# ── Notifications ─────────────────────────────────────────────
NOTIFICATIONS_ENABLED=true
# Optional: POST nudges to this webhook URL
# NUDGE_WEBHOOK_URL=https://your-webhook.com/xspan-nudges

# ── HIPAA Compliance ─────────────────────────────────────────
# Health data is NEVER sent to third-party AI tools (Claude, GPT, etc.)
# All health queries are processed by XSpan's HIPAA-compliant H-LLM
# PHI stays within XSpan's BAA-covered infrastructure at api.xspan.ai

# ── Debug ─────────────────────────────────────────────────────
# LOG_LEVEL=info    # debug | info | warn | error
# LOG_FILE=~/.xspan/agent.log
