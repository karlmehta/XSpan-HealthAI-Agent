# ============================================================
# XSpan HealthAI Agent — Environment Configuration
# Copy this file to .env — no API keys or cloud accounts needed
# ============================================================

# ── Apple Health (macOS only) ─────────────────────────────────
APPLE_HEALTH_ENABLED=true

# ── Google Health ─────────────────────────────────────────────
# Optional: Create credentials at https://console.cloud.google.com
GOOGLE_HEALTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_PORT=9876

# ── EHR Connection ────────────────────────────────────────────
EHR_ENABLED=false
# Provider: epic | cerner | redox | generic_fhir
EHR_PROVIDER=epic
EHR_FHIR_BASE_URL=https://fhir.example.org/api/FHIR/R4
EHR_CLIENT_ID=
EHR_OAUTH_PORT=9877

# ── Data Sync ─────────────────────────────────────────────────
# How often to sync health data from connected sources (minutes)
SYNC_INTERVAL_MINUTES=15

# ── Local Storage ─────────────────────────────────────────────
# All data stored locally, AES-256 encrypted
# DATA_DIR=~/.xspan/data

# ── Notifications ─────────────────────────────────────────────
NOTIFICATIONS_ENABLED=true

# ── Privacy ─────────────────────────────────────────────────
# All processing happens locally on your device
# No data is sent to any cloud server
# No third-party AI services are used

# ── Debug ─────────────────────────────────────────────────────
# LOG_LEVEL=info    # debug | info | warn | error
# LOG_FILE=~/.xspan/agent.log
